                  "name": "Note · Badge contrast guard",
                  "width": 700,
                  "fill": "$surface",
                  "cornerRadius": 10,
                  "stroke": "$line",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "gap": 6,
                  "padding": 14,
                  "children": [
                    {
                      "type": "text",
                      "id": "PVrn6",
                      "name": "Note title",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "NOTE · BADGE CONTRAST GUARD",
                      "fontFamily": "$font",
                      "fontSize": 10,
                      "fontWeight": "600",
                      "letterSpacing": 0.6
                    },
                    {
                      "type": "text",
                      "id": "n1ksst",
                      "name": "Note body",
                      "fill": "$text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "status-neutral-1 measures 4.60:1 on $subtle, a 0.10 margin over the 4.5:1 threshold for 12px text. Any opacity or alpha compositing applied to a parent will push it below threshold. Rule: opacity, fade, or disabled alpha must never be applied to a subtree that contains a status badge. Use a solid tone change instead. If opacity is unavoidable, status-neutral-1 must be darkened to #61707A (4.82:1) first, and this note updated.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Nsqcb",
