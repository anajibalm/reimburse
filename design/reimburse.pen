                      "name": "Note title",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "NOTE · STATUS COLOUR GRAMMAR",
                      "fontFamily": "$font",
                      "fontSize": 10,
                      "fontWeight": "600",
                      "letterSpacing": 0.6
                    },
                    {
                      "type": "text",
                      "id": "Gms3Q",
                      "name": "Note body",
                      "fill": "$text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "warning = Requester must act; success = paid; danger = rejected; neutral-1 = queued, awaiting Admin; neutral-2 = processed, awaiting another party; muted = cancelled. Blue is reserved for interactive action. Status text is authoritative; colour is supplementary.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "c3kAg4",
                  "x": 6608,
